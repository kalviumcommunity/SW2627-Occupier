rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function twoDigits(value) {
      return value < 10 ? '0' + string(value) : string(value);
    }

    function dateKeyFor(startTime) {
      let istTime = startTime + duration.value(330, 'm');

      return string(istTime.year()) + '-'
        + twoDigits(istTime.month()) + '-'
        + twoDigits(istTime.day());
    }

    function scheduleIdFor(branchId, resourceType, resourceId, startTime) {
      return branchId + '__' + resourceType + '__'
        + resourceId + '__' + dateKeyFor(startTime);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasUserProfile() {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function currentRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.get('role', null);
    }

    function isAdmin() {
      return hasUserProfile() && currentRole() == 'admin';
    }

    function isBranchManager() {
      return hasUserProfile() && currentRole() == 'branchManager';
    }

    function isStaff() {
      return hasUserProfile() && currentRole() == 'staff';
    }

    function isAssignedToBranch(branchId) {
      return isSignedIn()
        && exists(
          /databases/$(database)/documents/branches/$(branchId)
        )
        && (
          get(
            /databases/$(database)/documents/branches/$(branchId)
          ).data.get('managerUid', null) == request.auth.uid
          ||
          (
            get(
              /databases/$(database)/documents/branches/$(branchId)
            ).data.get('staffUids', []) is list
            && request.auth.uid in get(
              /databases/$(database)/documents/branches/$(branchId)
            ).data.get('staffUids', [])
          )
        );
    }

    function canManageAssignedBranch(branchId) {
      return isAssignedToBranch(branchId)
        && (isBranchManager() || isStaff());
    }

    function validUserDocument(userId) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'role',
          'photoUrl',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'name',
          'email',
          'role'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 254
        && request.resource.data.role in [
          'admin',
          'branchManager',
          'staff',
          'member'
        ]
        && (
          request.resource.data.get('photoUrl', null) == null
          || (
            request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.size() <= 2048
          )
        )
        && (
          request.resource.data.get('createdAt', null) == null
          || request.resource.data.createdAt is timestamp
        );
    }

    function validBookingDocument() {
      return request.resource.data.keys().hasOnly([
          'userId',
          'createdBy',
          'branchId',
          'resourceId',
          'resourceType',
          'startTime',
          'endTime',
          'status',
          'createdAt',
          'reservationScheduleId'
        ])
        && request.resource.data.keys().hasAll([
          'userId',
          'createdBy',
          'branchId',
          'resourceId',
          'resourceType',
          'startTime',
          'endTime',
          'status',
          'reservationScheduleId'
        ])
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.createdBy is string
        && request.resource.data.branchId is string
        && request.resource.data.branchId.size() > 0
        && request.resource.data.resourceId is string
        && request.resource.data.resourceId.size() > 0
        && request.resource.data.resourceType in ['desk', 'room']
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.startTime < request.resource.data.endTime
        && request.resource.data.reservationScheduleId is string
        && request.resource.data.status in [
          'pending',
          'confirmed',
          'cancelled',
          'completed'
        ]
        && (
          request.resource.data.get('createdAt', null) == null
          || request.resource.data.createdAt is timestamp
        );
    }

    function validBranchDocument() {
      return request.resource.data.keys().hasOnly([
          'name',
          'address',
          'city',
          'contactNumber',
          'totalDeskCapacity',
          'totalRoomCapacity',
          'openingTime',
          'closingTime',
          'status',
          'imageUrl',
          'managerUid',
          'staffUids',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'address',
          'city',
          'contactNumber',
          'totalDeskCapacity',
          'totalRoomCapacity',
          'openingTime',
          'closingTime',
          'status'
        ])
        && request.resource.data.name is string
        && request.resource.data.address is string
        && request.resource.data.city is string
        && request.resource.data.contactNumber is string
        && request.resource.data.totalDeskCapacity is int
        && request.resource.data.totalDeskCapacity >= 0
        && request.resource.data.totalRoomCapacity is int
        && request.resource.data.totalRoomCapacity >= 0
        && request.resource.data.openingTime is string
        && request.resource.data.closingTime is string
        && request.resource.data.status in ['active', 'inactive']
        && (
          request.resource.data.get('imageUrl', null) == null
          || request.resource.data.imageUrl is string
        )
        && (
          request.resource.data.get('managerUid', null) == null
          || request.resource.data.managerUid is string
        )
        && request.resource.data.get('staffUids', []) is list
        && (
          request.resource.data.get('createdAt', null) == null
          || request.resource.data.createdAt is timestamp
        );
    }

    function validDeskDocument() {
      return request.resource.data.keys().hasOnly([
          'name',
          'type',
          'floor',
          'status',
          'activeOccupancyId',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'type',
          'floor',
          'status'
        ])
        && request.resource.data.name is string
        && request.resource.data.type is string
        && request.resource.data.floor is string
        && request.resource.data.status in [
          'available',
          'occupied',
          'maintenance',
          'inactive'
        ]
        && (
          request.resource.data.get('activeOccupancyId', null) == null
          || request.resource.data.activeOccupancyId is string
        )
        && (
          request.resource.data.get('createdAt', null) == null
          || request.resource.data.createdAt is timestamp
        );
    }

    function validRoomDocument() {
      return request.resource.data.keys().hasOnly([
          'name',
          'capacity',
          'floor',
          'amenities',
          'status',
          'activeOccupancyId',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'capacity',
          'floor',
          'amenities',
          'status'
        ])
        && request.resource.data.name is string
        && request.resource.data.capacity is int
        && request.resource.data.capacity > 0
        && request.resource.data.floor is string
        && request.resource.data.amenities is list
        && request.resource.data.status in [
          'available',
          'occupied',
          'maintenance',
          'inactive'
        ]
        && (
          request.resource.data.get('activeOccupancyId', null) == null
          || request.resource.data.activeOccupancyId is string
        )
        && (
          request.resource.data.get('createdAt', null) == null
          || request.resource.data.createdAt is timestamp
        );
    }

    function validWalkInCustomer(occupancyData) {
      return occupancyData.customerName is string
        && occupancyData.customerName.size() > 0
        && occupancyData.customerName.size() <= 100
        && occupancyData.customerPhone is string
        && occupancyData.customerPhone.size() >= 3
        && occupancyData.customerPhone.size() <= 32;
    }

    function validOccupancyDocument(occupancyId) {
      return request.resource.data.keys().hasOnly([
          'occupancyId',
          'branchId',
          'resourceId',
          'resourceType',
          'userId',
          'bookingId',
          'status',
          'checkInTime',
          'checkOutTime',
          'source',
          'createdAt',
          'customerName',
          'customerPhone'
        ])
        && request.resource.data.keys().hasAll([
          'occupancyId',
          'branchId',
          'resourceId',
          'resourceType',
          'userId',
          'bookingId',
          'status',
          'checkInTime',
          'checkOutTime',
          'source',
          'createdAt'
        ])
        && request.resource.data.occupancyId == occupancyId
        && request.resource.data.branchId is string
        && request.resource.data.branchId.size() > 0
        && request.resource.data.resourceId is string
        && request.resource.data.resourceId.size() > 0
        && request.resource.data.resourceType in ['desk', 'room']
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && (
          request.resource.data.bookingId == null
          || request.resource.data.bookingId is string
        )
        && request.resource.data.status in ['active', 'completed']
        && request.resource.data.checkInTime is timestamp
        && (
          request.resource.data.checkOutTime == null
          || request.resource.data.checkOutTime is timestamp
        )
        && request.resource.data.source in ['booking', 'walkIn']
        && request.resource.data.createdAt is timestamp;
    }

    function validBookingLinkedOccupancy() {
      return request.resource.data.source == 'booking'
        && !request.resource.data.keys().hasAny([
          'customerName',
          'customerPhone'
        ])
        && request.resource.data.bookingId is string
        && exists(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        )
        && get(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        ).data.userId == request.auth.uid
        && get(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        ).data.status == 'confirmed'
        && get(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        ).data.branchId == request.resource.data.branchId
        && get(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        ).data.resourceId == request.resource.data.resourceId
        && get(
          /databases/$(database)/documents/bookings/$(request.resource.data.bookingId)
        ).data.resourceType == request.resource.data.resourceType;
    }

    function isResourceAvailable(branchId, resourceId, resourceType) {
      return (
          resourceType == 'desk'
          && exists(
            /databases/$(database)/documents/branches/$(branchId)/desks/$(resourceId)
          )
          && get(
            /databases/$(database)/documents/branches/$(branchId)/desks/$(resourceId)
          ).data.status == 'available'
        )
        || (
          resourceType == 'room'
          && exists(
            /databases/$(database)/documents/branches/$(branchId)/rooms/$(resourceId)
          )
          && get(
            /databases/$(database)/documents/branches/$(branchId)/rooms/$(resourceId)
          ).data.status == 'available'
        );
    }

    function resourcePath(branchId, resourceId, resourceType) {
      return resourceType == 'desk'
        ? /databases/$(database)/documents/branches/$(branchId)/desks/$(resourceId)
        : /databases/$(database)/documents/branches/$(branchId)/rooms/$(resourceId);
    }

    function occupancyPath(occupancyId) {
      return /databases/$(database)/documents/occupancies/$(occupancyId);
    }

    function hasMatchingActiveOccupancyAfter(
      occupancyId,
      branchId,
      resourceId,
      resourceType
    ) {
      let path = occupancyPath(occupancyId);

      return occupancyId is string
        && existsAfter(path)
        && getAfter(path).data.status == 'active'
        && getAfter(path).data.branchId == branchId
        && getAfter(path).data.resourceId == resourceId
        && getAfter(path).data.resourceType == resourceType
        && getAfter(path).data.checkInTime == request.time;
    }

    function hasMatchingCompletedOccupancyAfter(
      occupancyId,
      branchId,
      resourceId,
      resourceType
    ) {
      let path = occupancyPath(occupancyId);

      return occupancyId is string
        && exists(path)
        && get(path).data.status == 'active'
        && get(path).data.branchId == branchId
        && get(path).data.resourceId == resourceId
        && get(path).data.resourceType == resourceType
        && existsAfter(path)
        && getAfter(path).data.status == 'completed'
        && getAfter(path).data.checkOutTime == request.time;
    }

    function validResourceCheckIn(branchId, resourceId, resourceType) {
      let occupancyId = request.resource.data.get('activeOccupancyId', null);

      return resource.data.status == 'available'
        && request.resource.data.status == 'occupied'
        && resource.data.get('activeOccupancyId', null) == null
        && hasMatchingActiveOccupancyAfter(
          occupancyId,
          branchId,
          resourceId,
          resourceType
        );
    }

    function validResourceCheckOut(branchId, resourceId, resourceType) {
      let occupancyId = resource.data.get('activeOccupancyId', null);

      return resource.data.status == 'occupied'
        && request.resource.data.status == 'available'
        && occupancyId is string
        && request.resource.data.get('activeOccupancyId', null) == null
        && hasMatchingCompletedOccupancyAfter(
          occupancyId,
          branchId,
          resourceId,
          resourceType
        );
    }

    function validResourceUpdate(branchId, resourceId, resourceType) {
      return validDeskOrRoomDocument(resourceType)
        && (
          (
            isAdmin()
            && request.resource.data.status == resource.data.status
            && request.resource.data.get('activeOccupancyId', null)
              == resource.data.get('activeOccupancyId', null)
          )
          || (
            isAdmin()
            && resource.data.status != 'occupied'
            && request.resource.data.status != 'occupied'
            && resource.data.get('activeOccupancyId', null) == null
            && request.resource.data.get('activeOccupancyId', null) == null
          )
          || (
            (isAdmin() || canManageAssignedBranch(branchId))
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['status', 'activeOccupancyId'])
            && (
              validResourceCheckIn(branchId, resourceId, resourceType)
              || validResourceCheckOut(branchId, resourceId, resourceType)
            )
          )
        );
    }

    function validDeskOrRoomDocument(resourceType) {
      return resourceType == 'desk'
        ? validDeskDocument()
        : validRoomDocument();
    }

    function isAssignedBranchOccupancy(occupancyData) {
      return isAdmin() || canManageAssignedBranch(occupancyData.branchId);
    }

    function validOccupancyCheckout(occupancyId) {
      let data = resource.data;
      let resourceDocument = resourcePath(
        data.branchId,
        data.resourceId,
        data.resourceType
      );

      return isSignedIn()
        && (isAdmin() || canManageAssignedBranch(data.branchId))
        && validOccupancyDocument(occupancyId)
        && data.status == 'active'
        && data.checkOutTime == null
        && request.resource.data.status == 'completed'
        && request.resource.data.checkOutTime == request.time
        && request.resource.data.diff(data)
          .affectedKeys().hasOnly(['status', 'checkOutTime'])
        && data.get('activeOccupancyId', null) == null
        && exists(resourceDocument)
        && get(resourceDocument).data.status == 'occupied'
        && get(resourceDocument).data.get('activeOccupancyId', null)
          == occupancyId
        && existsAfter(resourceDocument)
        && getAfter(resourceDocument).data.status == 'available'
        && getAfter(resourceDocument).data.get('activeOccupancyId', null)
          == null;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isAdmin();

      allow create: if validUserDocument(userId)
        && (
          (isSelf(userId) && request.resource.data.role == 'member')
          || isAdmin()
        );

      allow update: if validUserDocument(userId)
        && request.resource.data.uid == resource.data.uid
        && (
          isAdmin()
          || (
            isSelf(userId)
            && request.resource.data.role == resource.data.role
            && request.resource.data.email == resource.data.email
            && request.resource.data.get('createdAt', null)
              == resource.data.get('createdAt', null)
            && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['name', 'photoUrl'])
          )
        );

      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      function scheduleMatchesBooking() {
        let scheduleId = request.resource.data.reservationScheduleId;
        let schedulePath =
          /databases/$(database)/documents/booking_schedules/$(scheduleId);

        return existsAfter(schedulePath)
          && getAfter(schedulePath).data.lastBookingId == bookingId
          && getAfter(schedulePath).data.branchId
            == request.resource.data.branchId
          && getAfter(schedulePath).data.resourceId
            == request.resource.data.resourceId
          && getAfter(schedulePath).data.resourceType
            == request.resource.data.resourceType
          && getAfter(schedulePath).data.dateKey
            == dateKeyFor(request.resource.data.startTime)
          && getAfter(schedulePath).data.reservations[bookingId].bookingId
            == bookingId
          && getAfter(schedulePath).data.reservations[bookingId].startTime
            == request.resource.data.startTime
          && getAfter(schedulePath).data.reservations[bookingId].endTime
            == request.resource.data.endTime
          && getAfter(schedulePath).data.reservations[bookingId].status
            == request.resource.data.status;
      }

      function scheduleMatchesCancellation() {
        let expectedScheduleId = scheduleIdFor(
          resource.data.branchId,
          resource.data.resourceType,
          resource.data.resourceId,
          resource.data.startTime
        );
        let scheduleId = resource.data.get(
          'reservationScheduleId',
          expectedScheduleId
        );
        let schedulePath =
          /databases/$(database)/documents/booking_schedules/$(scheduleId);

        return scheduleId == expectedScheduleId
          && exists(schedulePath)
          && existsAfter(schedulePath)
          && get(schedulePath).data.branchId == resource.data.branchId
          && get(schedulePath).data.resourceId == resource.data.resourceId
          && get(schedulePath).data.resourceType == resource.data.resourceType
          && get(schedulePath).data.dateKey == dateKeyFor(resource.data.startTime)
          && get(schedulePath).data.reservations[bookingId].bookingId == bookingId
          && get(schedulePath).data.reservations[bookingId].startTime
            == resource.data.startTime
          && get(schedulePath).data.reservations[bookingId].endTime
            == resource.data.endTime
          && get(schedulePath).data.reservations[bookingId].status
            == resource.data.status
          && getAfter(schedulePath).data.branchId == resource.data.branchId
          && getAfter(schedulePath).data.resourceId == resource.data.resourceId
          && getAfter(schedulePath).data.resourceType == resource.data.resourceType
          && getAfter(schedulePath).data.dateKey == dateKeyFor(resource.data.startTime)
          && getAfter(schedulePath).data.lastBookingId == bookingId
          && getAfter(schedulePath).data.reservations[bookingId].bookingId == bookingId
          && getAfter(schedulePath).data.reservations[bookingId].startTime
            == resource.data.startTime
          && getAfter(schedulePath).data.reservations[bookingId].endTime
            == resource.data.endTime
          && getAfter(schedulePath).data.reservations[bookingId].status
            == request.resource.data.status;
      }

      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
        );

      allow create: if isSignedIn()
        && validBookingDocument()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'confirmed'
        && request.resource.data.startTime > request.time
        && dateKeyFor(request.resource.data.startTime)
          == dateKeyFor(request.resource.data.endTime)
        && exists(
          /databases/$(database)/documents/branches/$(request.resource.data.branchId)
        )
        && get(
          /databases/$(database)/documents/branches/$(request.resource.data.branchId)
        ).data.status == 'active'
        && isResourceAvailable(
          request.resource.data.branchId,
          request.resource.data.resourceId,
          request.resource.data.resourceType
        )
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.reservationScheduleId
          == scheduleIdFor(
            request.resource.data.branchId,
            request.resource.data.resourceType,
            request.resource.data.resourceId,
            request.resource.data.startTime
          )
        && scheduleMatchesBooking();

      allow update: if (
          isAdmin()
          && validBookingDocument()
        ) || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status in ['pending', 'confirmed']
          && resource.data.startTime is timestamp
          && resource.data.startTime > request.time
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.branchId == resource.data.branchId
          && request.resource.data.resourceId == resource.data.resourceId
          && request.resource.data.resourceType == resource.data.resourceType
          && request.resource.data.startTime == resource.data.startTime
          && request.resource.data.endTime == resource.data.endTime
          && request.resource.data.get('createdAt', null)
            == resource.data.get('createdAt', null)
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled'
          && scheduleMatchesCancellation()
        );

      allow delete: if isAdmin();
    }

    match /booking_schedules/{scheduleId} {
      function validScheduleShape() {
        return request.resource.data.keys().hasAll([
            'branchId',
            'resourceId',
            'resourceType',
            'dateKey',
            'reservations',
            'lastBookingId',
            'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'branchId',
            'resourceId',
            'resourceType',
            'dateKey',
            'reservations',
            'lastBookingId',
            'updatedAt'
          ])
          && request.resource.data.branchId is string
          && request.resource.data.resourceId is string
          && request.resource.data.resourceType in ['desk', 'room']
          && request.resource.data.dateKey is string
          && request.resource.data.lastBookingId is string
          && request.resource.data.reservations is map
          && request.resource.data.updatedAt == request.time;
      }

      function matchesBookingAfter(bookingId) {
        let bookingPath =
          /databases/$(database)/documents/bookings/$(bookingId);
        let booking = getAfter(bookingPath).data;
        let reservation = request.resource.data.reservations[bookingId];

        return existsAfter(bookingPath)
          && booking.userId == request.auth.uid
          && booking.createdBy == request.auth.uid
          && booking.reservationScheduleId == scheduleId
          && booking.branchId == request.resource.data.branchId
          && booking.resourceId == request.resource.data.resourceId
          && booking.resourceType == request.resource.data.resourceType
          && booking.status == 'confirmed'
          && scheduleId == scheduleIdFor(
            booking.branchId,
            booking.resourceType,
            booking.resourceId,
            booking.startTime
          )
          && request.resource.data.dateKey == dateKeyFor(booking.startTime)
          && reservation.keys().hasAll([
            'bookingId',
            'startTime',
            'endTime',
            'status'
          ])
          && reservation.keys().hasOnly([
            'bookingId',
            'startTime',
            'endTime',
            'status'
          ])
          && reservation.bookingId == bookingId
          && reservation.startTime == booking.startTime
          && reservation.endTime == booking.endTime
          && reservation.status == booking.status;
      }

      function matchesCancelledBookingAfter(bookingId) {
        let bookingPath =
          /databases/$(database)/documents/bookings/$(bookingId);
        let previousBooking = get(bookingPath).data;
        let booking = getAfter(bookingPath).data;
        let oldReservation = resource.data.reservations[bookingId];
        let reservation = request.resource.data.reservations[bookingId];
        let expectedScheduleId = scheduleIdFor(
          booking.branchId,
          booking.resourceType,
          booking.resourceId,
          booking.startTime
        );
        let bookingScheduleId = booking.get(
          'reservationScheduleId',
          expectedScheduleId
        );

        return exists(bookingPath)
          && existsAfter(bookingPath)
          && previousBooking.userId == request.auth.uid
          && booking.userId == request.auth.uid
          && previousBooking.status in ['pending', 'confirmed']
          && previousBooking.startTime is timestamp
          && previousBooking.startTime > request.time
          && booking.status == 'cancelled'
          && bookingScheduleId == scheduleId
          && scheduleId == expectedScheduleId
          && previousBooking.branchId == resource.data.branchId
          && previousBooking.resourceId == resource.data.resourceId
          && previousBooking.resourceType == resource.data.resourceType
          && previousBooking.startTime == oldReservation.startTime
          && previousBooking.endTime == oldReservation.endTime
          && previousBooking.status == oldReservation.status
          && request.resource.data.branchId == resource.data.branchId
          && request.resource.data.resourceId == resource.data.resourceId
          && request.resource.data.resourceType == resource.data.resourceType
          && request.resource.data.dateKey == resource.data.dateKey
          && request.resource.data.dateKey == dateKeyFor(booking.startTime)
          && oldReservation.bookingId == bookingId
          && oldReservation.status in ['pending', 'confirmed']
          && reservation.keys().hasAll([
            'bookingId',
            'startTime',
            'endTime',
            'status'
          ])
          && reservation.keys().hasOnly([
            'bookingId',
            'startTime',
            'endTime',
            'status'
          ])
          && reservation.bookingId == bookingId
          && reservation.startTime == booking.startTime
          && reservation.endTime == booking.endTime
          && reservation.status == booking.status
          && reservation.diff(oldReservation).affectedKeys().hasOnly(['status'])
          && request.resource.data.reservations.diff(
            resource.data.reservations
          ).addedKeys().size() == 0
          && request.resource.data.reservations.diff(
            resource.data.reservations
          ).removedKeys().size() == 0
          && request.resource.data.reservations.diff(
            resource.data.reservations
          ).changedKeys().hasOnly([bookingId])
          && request.resource.data.reservations.diff(
            resource.data.reservations
          ).changedKeys().hasAll([bookingId])
          && request.resource.data.lastBookingId == bookingId;
      }

      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
        && validScheduleShape()
        && request.resource.data.reservations.keys().size() == 1
        && request.resource.data.reservations.keys()
          .hasAll([request.resource.data.lastBookingId])
        && matchesBookingAfter(request.resource.data.lastBookingId);

      allow update: if isSignedIn()
        && validScheduleShape()
        && resource.data.reservations is map
        && (
          (
            // New booking: add exactly one reservation without changing old ones.
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['reservations', 'lastBookingId', 'updatedAt'])
            && request.resource.data.reservations.diff(
              resource.data.reservations
            ).addedKeys().hasOnly([
              request.resource.data.lastBookingId
            ])
            && request.resource.data.reservations.diff(
              resource.data.reservations
            ).addedKeys().hasAll([
              request.resource.data.lastBookingId
            ])
            && request.resource.data.reservations.diff(
              resource.data.reservations
            ).removedKeys().size() == 0
            && request.resource.data.reservations.diff(
              resource.data.reservations
            ).changedKeys().size() == 0
            && matchesBookingAfter(request.resource.data.lastBookingId)
          )
          ||
          (
            // Cancellation: change only the matching reservation's status.
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['reservations', 'lastBookingId', 'updatedAt'])
            && request.resource.data.reservations.diff(
              resource.data.reservations
            ).addedKeys().size() == 0
            && request.resource.data.reservations.diff(
              resource.data.reservations
            ).removedKeys().size() == 0
            && matchesCancelledBookingAfter(
              request.resource.data.lastBookingId
            )
          )
        );

      allow delete: if false;
    }

    match /branches/{branchId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && validBranchDocument();
      allow update: if isAdmin() && validBranchDocument();
      allow delete: if isAdmin();

      match /desks/{deskId} {
        allow read: if isSignedIn();
        allow create: if validDeskDocument()
          && request.resource.data.status != 'occupied'
          && request.resource.data.get('activeOccupancyId', null) == null
          && (
            isAdmin()
            || (isBranchManager() && isAssignedToBranch(branchId))
          );
        allow delete: if isAdmin()
          || (isBranchManager() && isAssignedToBranch(branchId));
        allow update: if validResourceUpdate(branchId, deskId, 'desk');
      }

      match /rooms/{roomId} {
        allow read: if isSignedIn();
        allow create: if validRoomDocument()
          && request.resource.data.status != 'occupied'
          && request.resource.data.get('activeOccupancyId', null) == null
          && (
            isAdmin()
            || (isBranchManager() && isAssignedToBranch(branchId))
          );
        allow delete: if isAdmin()
          || (isBranchManager() && isAssignedToBranch(branchId));
        allow update: if validResourceUpdate(branchId, roomId, 'room');
      }
    }

    match /occupancies/{occupancyId} {
      allow read: if isAdmin()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
        )
        || isAssignedBranchOccupancy(resource.data);

      allow create: if isSignedIn()
        && validOccupancyDocument(occupancyId)
        && request.resource.data.status == 'active'
        && request.resource.data.checkOutTime == null
        && request.resource.data.checkInTime == request.time
        && request.resource.data.createdAt == request.time
        && isResourceAvailable(
          request.resource.data.branchId,
          request.resource.data.resourceId,
          request.resource.data.resourceType
        )
        && (
          (
            request.resource.data.userId == request.auth.uid
            && validBookingLinkedOccupancy()
          )
          || (
            request.resource.data.source == 'walkIn'
            && isAssignedBranchOccupancy(request.resource.data)
            && validWalkInCustomer(request.resource.data)
            && getAfter(resourcePath(
              request.resource.data.branchId,
              request.resource.data.resourceId,
              request.resource.data.resourceType
            )).data.status == 'occupied'
            && getAfter(resourcePath(
              request.resource.data.branchId,
              request.resource.data.resourceId,
              request.resource.data.resourceType
            )).data.get('activeOccupancyId', null) == occupancyId
          )
        );

      allow update: if validOccupancyCheckout(occupancyId);

      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
